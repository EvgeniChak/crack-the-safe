# Crack the Safe -- build configuration.
#
# NEVER edit `sdkconfig` directly: it is generated and gitignored, so an edit
# there is invisible to review. Everything goes here, and this file only SEEDS
# a new `sdkconfig` -- ESP-IDF does not re-apply it to an existing one. After
# changing anything below:
#
#     rm sdkconfig && idf.py build
#
# then confirm the key landed with `grep CONFIG_THE_KEY sdkconfig`.

CONFIG_IDF_TARGET="esp32s3"

# ---------------------------------------------------------------------------
# Memory: ESP32-S3R8 -- 8 MB OCTAL PSRAM in the package -- and 16 MB external
# flash. DIO, not QIO: it is what the factory image and Waveshare's demos boot
# with.
# ---------------------------------------------------------------------------
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384

CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# The S3's own USB-Serial/JTAG is what the USB-C port reaches in the S3
# orientation; the CH340 on the other orientation belongs to the ESP32.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# 1 kHz tick: LVGL animation and the 3 ms knob poll both want it.
CONFIG_FREERTOS_HZ=1000

# ---------------------------------------------------------------------------
# LVGL 9. Every MONTSERRAT_<n> the .eez-project references must be enabled
# here. The game's type is custom Roboto fonts embedded in the project and
# exported as ui_font_*; Montserrat is only the placeholder screen's.
# ---------------------------------------------------------------------------
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_FONT_MONTSERRAT_14=y

# lv_malloc() from the ESP heap rather than LVGL's fixed 64 KB pool. EEZ's
# export builds every screen at boot, and LVGL's out-of-memory handler is an
# infinite loop that presents as a watchdog reset.
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y

# ---- Wi-Fi and updates (main/net.c, main/web.c) ----------------------------
# A new image boots on probation; main.c confirms it once the game is up.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
# TLS and Wi-Fi buffers in PSRAM: internal RAM belongs to the display.
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_CMN=y
# Browsers send long headers.
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=512
# Size: the app has to fit a 7.94 MB update slot (partitions.csv).
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
# LVGL keeps CPU 1 busy while an update writes flash (the cache is off for
# both cores then); its idle task starving is expected, not a hang.
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=n
